# Copy to .env for local runs. NEVER commit a real .env (see .gitignore).

# Postgres connection (matches docker-compose service `db`, host port 5470)
STOCKFIND_PG_DSN=postgresql://stockfind:stockfind@localhost:5470/stockfind

# JWT signing secret — set your own; the app refuses to start on the literal default in non-debug.
STOCKFIND_JWT_SECRET=dev-only-change-me
STOCKFIND_JWT_TTL_SECONDS=3600

# Rate limits (slowapi limit strings, per client IP)
STOCKFIND_SEARCH_RATE_LIMIT=120/minute
STOCKFIND_RESERVE_RATE_LIMIT=60/minute

# Catalog seed
STOCKFIND_SEED=42
